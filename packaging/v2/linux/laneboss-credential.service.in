[Unit]
Description=Laneboss outside credential owner (%i)
Requires=laneboss-helper@%i.service
After=laneboss-helper@%i.service
Before=laneboss-service@%i.service

[Service]
Type=simple
Slice=system.slice
User=@BROKER@
Group=@BROKER@
ExecStart=@BINARY@ internal credential --config %i --native-owner --installation @INSTALLATION@ --key-file %d/native.key
LoadCredential=native.key:@KEY@
UMask=0077
Environment=GOMAXPROCS=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=@CRED@/owners/broker
TasksMax=64
MemoryMax=128M
KillMode=control-group
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=multi-user.target
