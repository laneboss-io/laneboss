[Unit]
Description=Laneboss unprivileged state service (%i)
Requires=laneboss-helper@%i.service
After=laneboss-helper@%i.service
Requires=laneboss-credential@%i.service
After=laneboss-credential@%i.service

[Service]
Type=simple
# Template instances default to system-<template>.slice; the helper, peer and client cgroup checks
# expect /system.slice/<unit>, so pin the slice.
Slice=system.slice
User=@SERVICE@
Group=@SERVICE@
ExecStart=@BINARY@ serve --config %i --installation @INSTALLATION@
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=user mnt pid ipc uts net cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths= /var/lib/laneboss-v2/service/%i /var/lib/laneboss-v2/secrets/%i @SOCKET@
ReadWritePaths= @CRED@/owners/identity
KillMode=control-group
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=multi-user.target
